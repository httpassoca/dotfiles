yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

yabai -m config debug_output on

# Appearence
yabai -m config layout                       bsp
yabai -m config top_padding    10
yabai -m config bottom_padding 10
yabai -m config left_padding   10
yabai -m config right_padding  10
yabai -m config window_gap     8
yabai -m config window_opacity on
yabai -m config active_window_opacity 1.0
yabai -m config normal_window_opacity 0.9

# Mouse focus
yabai -m config mouse_follows_focus          on 
yabai -m config focus_follows_mouse          autoraise


# Apps Rules
yabai -m rule --add app="^Spotify$" space=2
yabai -m rule --add app="^Books$" space=1
yabai -m rule --add app="^Notion$" space=3
yabai -m rule --add app="^Notion Calendar$" space=3

# Ignore apps
# mostly ones which doesn't fit well
yabai -m rule --add app="System Settings" manage=off
yabai -m rule --add app="BetterTouchTool" manage=off

yabai -m rule --apply